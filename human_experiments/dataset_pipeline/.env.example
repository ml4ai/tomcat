# ToMCAT dataset_pipeline configuration.
#
# Copy this to `.env` (which is gitignored) and adjust for your host. Real environment
# variables OVERRIDE values in this file, so `working_env=production make ...` still works.
# Point at a different file with TOMCAT_ENV_FILE=/path/to/other.env if needed.
#
# The values below are filled in for the orca host as a reference.

# --- Environment -------------------------------------------------------------------
# development -> SQLite under $ARTIFACT_DIR/.dev ; production -> Postgres
WORKING_ENV=production

# --- Postgres connection -----------------------------------------------------------
# PEER AUTH (recommended on orca, no password): set DB_HOST to the Unix-socket directory
# and leave DB_PASS empty. Postgres maps your OS user to the same-named PG role; nothing
# secret is stored. For TCP + password instead, set DB_HOST=localhost and DB_PASS in the
# gitignored .env (never here).
DB_HOST=/var/run/postgresql
DB_PORT=5432
TOMCAT_DB_NAME=tomcat
# DB_USER defaults to your OS username ($USER); set explicitly only if your PG role differs.
# DB_USER=
# Leave empty for peer auth. Only used when DB_HOST is a TCP host (e.g. localhost).
DB_PASS=

# --- Public web app connection (../dataset_website/) -------------------------------
# The website has its own project and .env.example; these are only here so a host can
# point both projects at ONE shared .env (both Settings classes use extra="ignore").
# The password is set in Postgres via the website's bin/setup_public_role.sql.
WEB_DB_USER=tomcat_public
WEB_DB_PASS=

# --- Artifact dir (SQLite export, logs, tmp) ---------------------------------------
# On orca this lives on the NFS-mounted SSD, not the local disk.
ARTIFACT_DIR=/media/snail-ssd/tomcat/artifacts

# --- Raw experiment inputs (read-only) ---------------------------------------------
# On orca these are the rsync'd copies under the SSD (gauss /tomcat/... -> /media/snail-ssd/tomcat/...).
# All input file paths are derived from this root (see common/config.py for the
# filenames). Override an individual path only when its filename changes — e.g. a
# fresh REDCap export carries a new date stamp:
DATA_ROOT_DIR=/media/snail-ssd/tomcat/data/raw/LangLab/experiments/study_3_pilot
# EXPERIMENT_ROOT_DIR=
# DATA_VALIDITY_WORKBOOK_PATH=
# STATION_TO_EEG_WORKBOOK_PATH=
# STATION_TO_MINECRAFT_PLAYERNAME_MAPPING_PATH=
# SELF_REPORT_DATA_PATH=
# SELF_REPORT_DATA_DICTIONARY_PATH=
# POST_GAME_SURVEY_DATA_PATH=
# POST_GAME_SURVEY_DATA_DICTIONARY_PATH=

# --- Public image URL root ---------------------------------------------------------
# Revisit when public serving moves to the starfish Caddy reverse proxy (Phase 2).
# IMAGE_URL_ROOT_DIR=https://ivilab.cs.arizona.edu/data/tomcat/group
