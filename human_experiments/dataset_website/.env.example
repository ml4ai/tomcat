# ToMCAT dataset_website configuration.
#
# Copy this to `.env` (which is gitignored) and adjust for your host. Real environment
# variables OVERRIDE values in this file, so per-invocation overrides still work.
# Point at a different file with TOMCAT_ENV_FILE=/path/to/other.env if needed —
# including at the pipeline project's .env, which is a superset of this one
# (both Settings classes ignore unknown variables).
#
# The values below are filled in for the orca host as a reference.

# --- Postgres connection -----------------------------------------------------------
# The site connects ONLY as the powerless read-only role created by
# bin/setup_public_role.sql. That role uses PASSWORD (scram) auth, not peer, so set
# the password in the gitignored .env (never here). Set it in Postgres with:
#   psql -d tomcat -c "ALTER ROLE tomcat_public PASSWORD '<choose-a-strong-one>'"
DB_HOST=/var/run/postgresql
DB_PORT=5432
TOMCAT_DB_NAME=tomcat
WEB_DB_USER=tomcat_public
WEB_DB_PASS=

# --- Artifact dir ------------------------------------------------------------------
# Where the offline bulk artifacts (tomcat.db, tomcat.dump — produced by the sibling
# dataset_pipeline project) live; the /download page serves them from here.
ARTIFACT_DIR=/media/snail-ssd/tomcat/artifacts
